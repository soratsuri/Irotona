{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irotona",
  "version": "0.2.0",
  "identifier": "com.ubird.luma-palette-csp-custom",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Irotona",
        "width": 340,
        "height": 310,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Irotona — Settings",
        "url": "settings.html",
        "width": 520,
        "height": 700,
        "decorations": true,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "soratsuri",
    "copyright": "Copyright (C) 2026 Andy Fang and contributors. Modifications copyright (C) 2026 soratsuri.",
    "homepage": "https://github.com/soratsuri/Irotona",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
